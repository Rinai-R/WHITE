---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---
<section aria-labelledby="latest-posts-title" class="mb-5">
    <header class="onload-animation mb-4 flex items-end justify-between px-1">
        <div>
            <div class="mb-1 flex items-center gap-2 text-[var(--primary)]">
                <Icon name="material-symbols:auto-stories-outline-rounded" class="text-xl" />
                <span class="text-xs font-bold uppercase">Journal</span>
            </div>
            <h2 id="latest-posts-title" class="text-2xl font-bold text-90">最新文章</h2>
        </div>
        <span class="text-sm text-50">{page.total} 篇</span>
    </header>
    <div class="transition flex flex-col gap-3 md:gap-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
    </div>
</section>
